<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="@color/green_light"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivActivityThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_explore"
            app:tint="@color/green_primary" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSightingName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Red Kangaroo" />

        <TextView
            android:id="@+id/tvSightingDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_mid"
            android:textSize="12sp"
            tools:text="31 May 2026" />

        <TextView
            android:id="@+id/tvSightingNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_mid"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="Spotted near the old oak tree."
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>